rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /profiles/{userId} {
      allow read: if signedIn();
      allow create, update: if isOwner(userId);
      allow delete: if false;
    }

    // Public job catalog. Unauthenticated seed on first launch needs write.
    match /JobList/{jobId} {
      allow read, write: if true;
    }

    match /applications/{appId} {
      allow read: if signedIn() && (
        resource.data.usr_id == request.auth.uid ||
        resource.data.recruiter_id == request.auth.uid
      );
      allow create: if signedIn() && request.resource.data.usr_id == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.usr_id == request.auth.uid ||
        resource.data.recruiter_id == request.auth.uid
      );
      allow delete: if false;
    }

    match /bookmarks/{bookmarkId} {
      allow read: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.user_id == request.auth.uid;
    }

    match /room/{roomId} {
      allow read, write: if signedIn();
    }

    match /messages/{messageId} {
      allow read, write: if signedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
